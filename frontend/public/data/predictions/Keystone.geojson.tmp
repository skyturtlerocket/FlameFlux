re not a surprise), but this is 'best available', not 'production-ready' -- represent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-07-25 02:03:51.594413+00:00","valid_from_utc":"2026-07-24 00:00:00","valid_to_utc":"2026-07-25 00:00:00","wfigs_date_current_utc":"2026-07-24 22:20:00+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":2,"degraded_history":false,"containment_pct":69,"acres_wfigs":3042.1169078799,"hour":3,"valid_at_utc":"2026-07-24 03:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-108.19101,40.20413],[-108.19136,40.20413],[-108.19136,40.2044],[-108.19065,40.20467],[-108.19065,40.20359],[-108.19101,40.20359],[-108.19101,40.20413]]],[[[-108.19171,40.20494],[-108.19136,40.20494],[-108.19136,40.2044],[-108.19171,40.2044],[-108.19171,40.20494]]],[[[-108.19206,40.20467],[-108.19242,40.20467],[-108.19242,40.20521],[-108.19206,40.20521],[-108.19206,40.20467]]],[[[-108.19242,40.20521],[-108.19312,40.20521],[-108.19312,40.20575],[-108.19277,40.20575],[-108.19277,40.20548],[-108.19242,40.20548],[-108.19242,40.20521]]],[[[-108.19489,40.20764],[-108.19524,40.20764],[-108.19524,40.20898],[-108.19489,40.20898],[-108.19489,40.20764]]],[[[-108.20053,40.20844],[-108.20089,40.20844],[-108.20089,40.20871],[-108.20053,40.20871],[-108.20053,40.20844]]],[[[-108.19559,40.20898],[-108.19595,40.20898],[-108.19595,40.21006],[-108.19559,40.21006],[-108.19559,40.20898]]],[[[-108.2023,40.20952],[-108.2023,40.21006],[-108.20195,40.21006],[-108.20195,40.20952],[-108.2023,40.20952]]],[[[-108.20089,40.21006],[-108.20089,40.21087],[-108.20053,40.21087],[-108.20053,40.21006],[-108.20089,40.21006]]],[[[-108.1963,40.21087],[-108.19665,40.21087],[-108.19665,40.212