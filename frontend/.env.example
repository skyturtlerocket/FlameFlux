# Copy this file to `.env` (which is gitignored) and fill in real values for
# local testing with `vercel dev`. In production, set these in the Vercel
# dashboard: Settings -> Environment Variables. Never commit real keys.

# Resend API key — used ONLY by the serverless function api/contact.js (server
# side), never exposed to the browser. Get one at https://resend.com
RESEND_API_KEY=re_your_key_here

# Where contact-form submissions are emailed. On Resend's free tier without a
# verified domain, this MUST be the email that owns your Resend account.
CONTACT_TO_EMAIL=flame.flux1@gmail.com

# Sender shown on the email. Without a verified domain, keep the Resend default.
CONTACT_FROM_EMAIL=FlameFlux Contact <onboarding@resend.dev>
