epresent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-08-08 14:26:22.865147+00:00","valid_from_utc":"2026-08-08 00:00:00","valid_to_utc":"2026-08-09 00:00:00","wfigs_date_current_utc":"2026-08-08 14:05:09+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":21,"degraded_history":false,"containment_pct":1,"acres_wfigs":97538.21069475975,"hour":3,"valid_at_utc":"2026-08-08 03:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-120.71837,47.88807],[-120.71877,47.88807],[-120.71877,47.88834],[-120.71837,47.88834],[-120.71837,47.88807]]],[[[-120.71958,47.88861],[-120.71998,47.88861],[-120.71998,47.88915],[-120.71958,47.88915],[-120.71958,47.88861]]],[[[-120.71797,47.88915],[-120.71837,47.88915],[-120.71837,47.88942],[-120.71797,47.88942],[-120.71797,47.88915]]],[[[-120.71958,47.89023],[-120.71958,47.8905],[-120.71918,47.8905],[-120.71918,47.89023],[-120.71958,47.89023]]],[[[-120.71676,47.89589],[-120.71676,47.89562],[-120.71636,47.89562],[-120.71636,47.89508],[-120.71595,47.89508],[-120.71595,47.89481],[-120.71676,47.89454],[-120.71676,47.89427],[-120.71877,47.89427],[-120.71877,47.89454],[-120.71958,47.89481],[-120.71958,47.89535],[-120.71998,47.89535],[-120.71998,47.89616],[-120.71958,47.89616],[-120.71958,47.89696],[-120.71918,47.89696],[-120.71918,47.89723],[-120.71757,47.89696],[-120.71757,47.89642],[-120.71716,47.89642],[-120.71716,47.89589],[-120.71676,47.89589]]],[[[-120.80735,48.01824],[-120.80735,48.01904],[-120.80654,48.01904],[-120.80654,48.01877],[-120.80533,48.01877],[-120.80533,48.01958],[-120.80614,48.01958],[-120.80614,48.01985],[-120.80654,48.01985],[-120.80654,48.02012],[-120.80735,48.02012],[-120.80735,48.02039],[-120.80775,48.0