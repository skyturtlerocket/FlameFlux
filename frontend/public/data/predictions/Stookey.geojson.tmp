n relative to its own training. The measured t0-window numbers above already reflect that (they are not a surprise), but this is 'best available', not 'production-ready' -- represent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-07-30 18:12:55.648757+00:00","valid_from_utc":"2026-07-30 00:00:00","valid_to_utc":"2026-07-31 00:00:00","wfigs_date_current_utc":"2026-07-30 16:23:23+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":1,"degraded_history":true,"containment_pct":95,"acres_wfigs":12781.633597236289,"hour":7,"valid_at_utc":"2026-07-30 07:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-112.58445,40.13015],[-112.58445,40.12988],[-112.5841,40.12988],[-112.5841,40.13068],[-112.58374,40.13068],[-112.58374,40.12934],[-112.58445,40.12934],[-112.58445,40.12907],[-112.58551,40.12907],[-112.58551,40.12988],[-112.5848,40.12988],[-112.5848,40.13015],[-112.58445,40.13015]]],[[[-112.57528,40.13796],[-112.57528,40.13661],[-112.57422,40.13661],[-112.57422,40.13634],[-112.57387,40.13634],[-112.57387,40.1358],[-112.57352,40.1358],[-112.57352,40.135],[-112.57316,40.135],[-112.57316,40.13473],[-112.57422,40.13473],[-112.57422,40.13446],[-112.57352,40.13446],[-112.57352,40.13419],[-112.57493,40.13419],[-112.57493,40.13392],[-112.57387,40.13392],[-112.57387,40.13365],[-112.57457,40.13365],[-112.57457,40.13338],[-112.57387,40.13338],[-112.57387,40.13284],[-112.57352,40.13284],[-112.57352,40.13257],[-112.57387,40.13257],[-112.57387,40.13203],[-112.57457,40.13176],[-112.57457,40.13068],[-112.57422,40.13068],[-112.57422,40.13015],[-112.57457,40.13015],[-112.57457,40.12961],[-112.57387,40.12934],[-112.57387,40.12853],[-112.57457,40.12853],[-112.57457,40.12799