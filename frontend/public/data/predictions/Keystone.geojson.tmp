_to_utc":"2026-07-25 00:00:00","wfigs_date_current_utc":"2026-07-24 22:20:00+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":2,"degraded_history":false,"containment_pct":69,"acres_wfigs":3042.1169078799,"hour":4,"valid_at_utc":"2026-07-24 04:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-108.1963,40.21464],[-108.19595,40.21464],[-108.19595,40.21437],[-108.1963,40.21437],[-108.1963,40.2141],[-108.19595,40.2141],[-108.19595,40.21383],[-108.1963,40.21383],[-108.1963,40.21303],[-108.19559,40.2133],[-108.19559,40.21195],[-108.19524,40.21195],[-108.19524,40.2106],[-108.19489,40.2106],[-108.19489,40.20844],[-108.19453,40.20844],[-108.19453,40.20764],[-108.19418,40.20764],[-108.19418,40.2071],[-108.19348,40.2071],[-108.19348,40.20602],[-108.19277,40.20629],[-108.19277,40.20575],[-108.19242,40.20575],[-108.19242,40.20548],[-108.19206,40.20548],[-108.19206,40.20521],[-108.19171,40.20521],[-108.19171,40.20494],[-108.1903,40.20494],[-108.1903,40.20467],[-108.18995,40.20467],[-108.18995,40.20171],[-108.1903,40.20171],[-108.1903,40.20305],[-108.19101,40.20278],[-108.19101,40.20359],[-108.19171,40.20332],[-108.19171,40.20386],[-108.19242,40.20386],[-108.19242,40.2044],[-108.19312,40.2044],[-108.19312,40.20521],[-108.19453,40.20548],[-108.19453,40.20602],[-108.19524,40.20602],[-108.19524,40.20629],[-108.19489,40.20629],[-108.19489,40.20656],[-108.19524,40.20656],[-108.19524,40.20764],[-108.19595,40.20791],[-108.19595,40.20898],[-108.19665,40.20925],[-108.19665,40.21033],[-108.19771,40.21033],[-108.19771,40.21006],[-108.19912,40.21006],[-108.19912,40.20952],[-108.19983,40.20952],[-108.19983,40.20871],[-108.20053,40.20844],[-108.20053,40.20764],[-108.20124,40.20764],[-108.20124,40.20737],[-108.20159,40.20737],[-108.20159,40.20844],[-108.20195,40.20844],[-108.20195,40.20737],[-108.2023,40.20737],[-108.2023,40.20844],[-108.20371,40.20871],[-108.20371,40.21006],[-108.20336,40.21006],[-108.20336,40.