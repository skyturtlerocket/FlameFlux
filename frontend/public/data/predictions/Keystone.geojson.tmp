ent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-07-25 02:03:51.594413+00:00","valid_from_utc":"2026-07-24 00:00:00","valid_to_utc":"2026-07-25 00:00:00","wfigs_date_current_utc":"2026-07-24 22:20:00+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":2,"degraded_history":false,"containment_pct":69,"acres_wfigs":3042.1169078799,"hour":12,"valid_at_utc":"2026-07-24 12:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-108.2023,40.20548],[-108.20195,40.20548],[-108.20195,40.20521],[-108.2023,40.20521],[-108.2023,40.20548]]],[[[-108.21218,40.20602],[-108.21218,40.20575],[-108.21253,40.20575],[-108.21253,40.20602],[-108.21218,40.20602]]],[[[-108.21147,40.2071],[-108.21147,40.20683],[-108.21253,40.20683],[-108.21253,40.2071],[-108.21147,40.2071]]],[[[-108.21077,40.20844],[-108.21147,40.20844],[-108.21147,40.20737],[-108.21395,40.20737],[-108.21395,40.20764],[-108.21324,40.20764],[-108.21324,40.20817],[-108.21253,40.20817],[-108.21253,40.20871],[-108.21218,40.20871],[-108.21218,40.20817],[-108.21183,40.20817],[-108.21183,40.20898],[-108.21253,40.20898],[-108.21253,40.20925],[-108.21147,40.20925],[-108.21147,40.20871],[-108.21077,40.20871],[-108.21077,40.20844]],[[-108.21289,40.20791],[-108.21289,40.20764],[-108.21183,40.20764],[-108.21183,40.20791],[-108.21289,40.20791]]],[[[-108.21147,40.21087],[-108.21147,40.2106],[-108.21218,40.2106],[-108.21218,40.21087],[-108.21147,40.21087]]],[[[-108.21324,40.21895],[-108.21324,40.21868],[-108.21359,40.21868],[-108.21359,40.21895],[-108.21324,40.21895]]],[[[-108.2143,40.21949],[-108.21395,40.21949],[-108.21395,40.21922],[-108.2143,40.21922],[-108.2143,40.21949]]],[[[-108.221,40.22623],[-108.221,40.22569],[-1