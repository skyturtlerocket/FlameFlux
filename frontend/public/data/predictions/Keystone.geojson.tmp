tion relative to its own training. The measured t0-window numbers above already reflect that (they are not a surprise), but this is 'best available', not 'production-ready' -- represent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-07-25 02:03:51.594413+00:00","valid_from_utc":"2026-07-24 00:00:00","valid_to_utc":"2026-07-25 00:00:00","wfigs_date_current_utc":"2026-07-24 22:20:00+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":2,"degraded_history":false,"containment_pct":69,"acres_wfigs":3042.1169078799,"hour":8,"valid_at_utc":"2026-07-24 08:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-108.20618,40.20278],[-108.20618,40.20252],[-108.20653,40.20252],[-108.20653,40.20278],[-108.20618,40.20278]]],[[[-108.209,40.21572],[-108.209,40.21545],[-108.20936,40.21545],[-108.20936,40.21572],[-108.209,40.21572]]],[[[-108.209,40.21626],[-108.209,40.21599],[-108.20936,40.21599],[-108.20936,40.21626],[-108.209,40.21626]]],[[[-108.21042,40.2168],[-108.21042,40.21653],[-108.21077,40.21653],[-108.21077,40.2168],[-108.21042,40.2168]]],[[[-108.20477,40.22111],[-108.20512,40.22111],[-108.20512,40.22138],[-108.20477,40.22138],[-108.20477,40.22111]]],[[[-108.20442,40.22138],[-108.20477,40.22138],[-108.20477,40.22165],[-108.20406,40.22165],[-108.20406,40.22111],[-108.20442,40.22111],[-108.20442,40.22138]]],[[[-108.21395,40.22246],[-108.21395,40.22219],[-108.21465,40.22219],[-108.21465,40.22246],[-108.21395,40.22246]]],[[[-108.20406,40.22192],[-108.20442,40.22192],[-108.20442,40.22273],[-108.20371,40.22246],[-108.20371,40.22219],[-108.20406,40.22219],[-108.20406,40.22192]]],[[[-108.21112,40.22677],[-108.20971,40.22677],[-108.20971,40.22596],[-108.21042,40.225