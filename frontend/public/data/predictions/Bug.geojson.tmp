259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-08-13 20:10:26.809854+00:00","valid_from_utc":"2026-08-13 00:00:00","valid_to_utc":"2026-08-14 00:00:00","wfigs_date_current_utc":"2026-08-13 18:03:41+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":5,"degraded_history":false,"containment_pct":3,"acres_wfigs":88421.65124924152,"hour":4,"valid_at_utc":"2026-08-13 04:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-119.99964,39.74091],[-119.99964,39.74064],[-119.99999,39.74064],[-119.99999,39.74091],[-119.99964,39.74091]]],[[[-119.99859,39.74387],[-119.99859,39.7436],[-119.99894,39.7436],[-119.99894,39.74387],[-119.99859,39.74387]]],[[[-119.99859,39.74684],[-119.99859,39.74603],[-119.99929,39.74603],[-119.99929,39.74684],[-119.99859,39.74684]]],[[[-120.00209,39.7463],[-120.00209,39.74765],[-120.00069,39.74765],[-120.00069,39.74657],[-120.00104,39.74657],[-120.00104,39.7463],[-120.00209,39.7463]]],[[[-120.00174,39.74845],[-120.00174,39.74819],[-120.00209,39.74819],[-120.00209,39.74792],[-120.00244,39.74792],[-120.00244,39.74765],[-120.00314,39.74738],[-120.00314,39.74899],[-120.00279,39.74899],[-120.00279,39.74926],[-120.00139,39.74899],[-120.00139,39.74845],[-120.00174,39.74845]]],[[[-119.99999,39.74899],[-119.99999,39.74953],[-119.99929,39.74953],[-119.99929,39.74872],[-119.99999,39.74899]]],[[[-120.00069,39.74953],[-120.00069,39.74926],[-120.00104,39.74926],[-120.00104,39.74953],[-120.00069,39.74953]]],[[[-120.00279,39.75061],[-120.00279,39.75007],[-120.00349,39.75007],[-120.00349,39.75061],[-120.00279,39.75061]]],[[[-120.00034,39.75465],[-120.00034,39.75438],[-120.00069,39.75438],[-120.00069,39.75465],[-120.00034,39.75465]]],[[[-119.99929,39.75546],[-119.99929,39.75573],[-119.99894,39.75573],[-119.99894,39.75492],[-119.99964,39.75492],[-119.99964,39.75546],[-119.99929,39.75546]]],[[[-119.99719,39.75708],[-119.99719,39.75681],[-119.997