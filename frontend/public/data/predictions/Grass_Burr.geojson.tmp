s 'best available', not 'production-ready' -- represent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-08-14 12:40:14.410886+00:00","valid_from_utc":"2026-08-14 00:00:00","valid_to_utc":"2026-08-15 00:00:00","wfigs_date_current_utc":"2026-08-14 12:22:52+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":1,"degraded_history":true,"containment_pct":85,"acres_wfigs":2623.1821664661975,"hour":19,"valid_at_utc":"2026-08-14 19:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-100.30659,34.06125],[-100.30659,34.06152],[-100.30627,34.06152],[-100.30627,34.06125],[-100.30659,34.06125]]],[[[-100.3567,34.10599],[-100.3567,34.10626],[-100.35638,34.10626],[-100.35638,34.10653],[-100.3567,34.10653],[-100.3567,34.1068],[-100.3541,34.1068],[-100.3541,34.10707],[-100.35442,34.10707],[-100.35442,34.10814],[-100.35475,34.10814],[-100.35475,34.10761],[-100.35508,34.10761],[-100.35508,34.10814],[-100.35573,34.10814],[-100.35573,34.10761],[-100.3567,34.10761],[-100.3567,34.10814],[-100.35638,34.10814],[-100.35638,34.10895],[-100.35605,34.10895],[-100.35605,34.10841],[-100.35573,34.10841],[-100.35573,34.10895],[-100.3554,34.10895],[-100.3554,34.10841],[-100.35508,34.10841],[-100.35508,34.10895],[-100.35475,34.10895],[-100.35475,34.10841],[-100.35377,34.10841],[-100.35377,34.10895],[-100.35312,34.10895],[-100.35312,34.10922],[-100.35377,34.10922],[-100.35377,34.11003],[-100.35345,34.11003],[-100.35345,34.1103],[-100.35377,34.1103],[-100.35377,34.11111],[-100.35312,34.11111],[-100.35312,34.11138],[-100.35377,34.11138],[-100.35377,34.11165],[-100.35312,34.11165],[-100.35312,34.11273],[-100.35247,34.11273],[-100.35247,34.11353],[-100.3528,34.11353],[-100.3528,34.11299