o growth on 4 of 11 active fires, because reach is decoded only where the segment gate is open and the day guard holds the gate shut below its 0.39 threshold. A published zero is a guard decision, not a measurement that the fire will not move. The displayed hourly contours are constant-local-rate interpolation of a model trained on 24-hour endpoints; they are spatially validated but have no independently observed sub-daily timing labels. Detached spotting is not represented, and the seven-fire audit behind the validation numbers was not blind because those fires had been reviewed in prior experiments.","model_format":"XGBoost UBJ","deployment_status":"website_default","gate_model_checkpoint":null,"gate_threshold":0.25,"gate_open_segments":0,"gate_total_segments":679,"hotspot_gate_radius_px":16.0,"hotspot_gate_lookback_hours":8,"hotspot_gate_min_detections":5,"hotspot_gate_detections":0,"hotspot_gate_applied":false,"hotspot_gate_reason":"no thermal detections available","hotspot_anchor_applied":false,"hotspot_anchor_detections":0,"hotspot_anchor_segments":0,"hotspot_anchor_radius_px":16.0,"hotspot_anchor_min_outside_detections":3,"hotspot_anchor_lookback_hours":24,"hotspot_anchor_fallback_applied":true,"hotspot_anchor_raw_detections":0,"hotspot_previous_window_detections":0,"hotspot_dropout":false,"recent_growth_gate_applied":true,"recent_growth_gate_lag":"2d","recent_growth_gate_band_px":8.0,"recent_growth_gate_open":66,"recent_growth_gate_segments":679,"day_guard_model_checkpoint":"output/q65_79fires_day_guard_v1/q65_day_guard.ubj","day_guard_threshold":0.39,"day_growth_probability":0.11481358855962753,"day_guard_active":false,"predicted_regime":"quiet","selected_operator":"guarded_q65_reach","spatial_validation":{"1":{"monotone":true,"endpoint_exact":true,"source_components":13,"maximum_perimeter_components":13,"source_connected":true,"disconnected_pixels":0,"disconnected_steps":[],"valid":true},"5":{"monotone":true,"endpoint_exact":true,"source_components":13,"ma