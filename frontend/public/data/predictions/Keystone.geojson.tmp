, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-07-25 02:03:51.594413+00:00","valid_from_utc":"2026-07-24 00:00:00","valid_to_utc":"2026-07-25 00:00:00","wfigs_date_current_utc":"2026-07-24 22:20:00+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":2,"degraded_history":false,"containment_pct":69,"acres_wfigs":3042.1169078799,"hour":20,"valid_at_utc":"2026-07-24 20:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-108.21218,40.2106],[-108.21218,40.21087],[-108.21147,40.21087],[-108.21147,40.2106],[-108.21218,40.2106]]],[[[-108.21677,40.22111],[-108.21642,40.22111],[-108.21642,40.22084],[-108.21677,40.22084],[-108.21677,40.22111]]],[[[-108.22489,40.22731],[-108.22453,40.22731],[-108.22453,40.22704],[-108.22489,40.22704],[-108.22489,40.22731]]],[[[-108.22312,40.22758],[-108.22277,40.22758],[-108.22277,40.22731],[-108.22312,40.22731],[-108.22312,40.22758]]],[[[-108.20265,40.23674],[-108.2023,40.23674],[-108.2023,40.23647],[-108.20265,40.23647],[-108.20265,40.23674]]],[[[-108.21324,40.23728],[-108.21289,40.23728],[-108.21289,40.23701],[-108.21324,40.23701],[-108.21324,40.23728]]],[[[-108.19065,40.25318],[-108.1903,40.25318],[-108.1903,40.25291],[-108.18959,40.25291],[-108.18959,40.25237],[-108.18889,40.25237],[-108.18889,40.2521],[-108.18854,40.2521],[-108.18854,40.25264],[-108.18924,40.25264],[-108.18924,40.25291],[-108.18748,40.25291],[-108.18748,40.25237],[-108.18712,40.25237],[-108.18712,40.25291],[-108.18677,40.25291],[-108.18677,40.25183],[-108.18748,40.2521],[-108.18748,40.25156],[-108.18818,40.25156],[-108.18818,40.25102],[-108.18889,40.25102],[-108.18889,40.25049],[-108.18818,40.25049],[-108.18818,40.25022],[-108.18889,40.24995],[-108.18889,40.24941],[-108.18924,40.24941],[-108.1