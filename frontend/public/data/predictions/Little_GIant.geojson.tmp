 out-of-distribution relative to its own training. The measured t0-window numbers above already reflect that (they are not a surprise), but this is 'best available', not 'production-ready' -- represent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-08-08 14:26:22.865147+00:00","valid_from_utc":"2026-08-08 00:00:00","valid_to_utc":"2026-08-09 00:00:00","wfigs_date_current_utc":"2026-08-08 14:05:09+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":21,"degraded_history":false,"containment_pct":1,"acres_wfigs":97538.21069475975,"hour":18,"valid_at_utc":"2026-08-08 18:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-120.71555,47.88753],[-120.71555,47.88726],[-120.71595,47.88726],[-120.71595,47.88753],[-120.71555,47.88753]]],[[[-120.71837,47.88807],[-120.71877,47.88807],[-120.71877,47.88834],[-120.71837,47.88834],[-120.71837,47.88807]]],[[[-120.71958,47.88861],[-120.71998,47.88861],[-120.71998,47.88915],[-120.71958,47.88915],[-120.71958,47.88861]]],[[[-120.71797,47.88942],[-120.71797,47.88915],[-120.71837,47.88915],[-120.71837,47.88942],[-120.71797,47.88942]]],[[[-120.71918,47.89023],[-120.71958,47.89023],[-120.71958,47.8905],[-120.71918,47.8905],[-120.71918,47.89023]]],[[[-120.72199,47.88942],[-120.7236,47.88942],[-120.7236,47.88969],[-120.72521,47.88996],[-120.72521,47.89023],[-120.72602,47.8905],[-120.72602,47.89077],[-120.72642,47.89077],[-120.72642,47.8913],[-120.72683,47.8913],[-120.72683,47.89157],[-120.72884,47.89157],[-120.72884,47.8905],[-120.72844,47.8905],[-120.72844,47.88807],[-120.72884,47.88807],[-120.72884,47.88753],[-120.72924,47.88753],[-120.72924,47.88726],[-120.73005,47.88726],[-120.73005,47.88699],[-120.73085,47.88699],[-120