# Virtual environments
myvenv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Secrets / environment variables — never commit real keys
.env
.env.*
!.env.example

# Dependencies (reinstalled from package.json / requirements.txt, never committed)
node_modules/

# Build output (regenerated by `npm run build`; Vercel builds fresh, doesn't use this)
/frontend/build/

# OS / editor / Python cruft
.DS_Store
__pycache__/
*.pyc
