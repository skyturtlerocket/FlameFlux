 not a precision-guaranteed one.","issued_at_utc":"2026-08-08 14:26:22.865147+00:00","valid_from_utc":"2026-08-08 00:00:00","valid_to_utc":"2026-08-09 00:00:00","wfigs_date_current_utc":"2026-08-08 14:05:09+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":21,"degraded_history":false,"containment_pct":1,"acres_wfigs":97538.21069475975,"hour":6,"valid_at_utc":"2026-08-08 06:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-120.71555,47.88726],[-120.71595,47.88726],[-120.71595,47.88753],[-120.71555,47.88753],[-120.71555,47.88726]]],[[[-120.71837,47.88807],[-120.71877,47.88807],[-120.71877,47.88834],[-120.71837,47.88834],[-120.71837,47.88807]]],[[[-120.71958,47.88861],[-120.71998,47.88861],[-120.71998,47.88915],[-120.71958,47.88915],[-120.71958,47.88861]]],[[[-120.71797,47.88915],[-120.71837,47.88915],[-120.71837,47.88942],[-120.71797,47.88942],[-120.71797,47.88915]]],[[[-120.71918,47.89023],[-120.71958,47.89023],[-120.71958,47.8905],[-120.71918,47.8905],[-120.71918,47.89023]]],[[[-120.82305,48.01554],[-120.82305,48.01608],[-120.82224,48.01581],[-120.82224,48.01608],[-120.82184,48.01608],[-120.82184,48.01662],[-120.82144,48.01662],[-120.82144,48.01689],[-120.82224,48.01689],[-120.82224,48.0177],[-120.82184,48.0177],[-120.82184,48.01824],[-120.82224,48.01824],[-120.82224,48.01851],[-120.82184,48.01851],[-120.82184,48.01877],[-120.82144,48.01877],[-120.82144,48.01904],[-120.82104,48.01904],[-120.82104,48.01931],[-120.82063,48.01931],[-120.82063,48.01985],[-120.81983,48.01985],[-120.81983,48.02012],[-120.81942,48.02012],[-120.81942,48.01985],[-120.81822,48.01985],[-120.81822,48.02012],[-120.81701,48.02012],[-120.81701,48.02066],[-120.81661,48.02066],[-120.81661,48.02012],[-120.8154,48.02012],[-120.8154,48.01985],[-120.815,48.01985],[-120.815,48.01958],[-120.8154,48.01958],[-120.8154,48.01931],[-120.81379,48.01904],[-120.81379,48.01851],[-120.81298,48.01851],[-120.81298,48.01797],[-120.812