int, not a precision-guaranteed one.","issued_at_utc":"2026-07-30 18:12:55.648757+00:00","valid_from_utc":"2026-07-30 00:00:00","valid_to_utc":"2026-07-31 00:00:00","wfigs_date_current_utc":"2026-07-30 16:23:23+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":1,"degraded_history":true,"containment_pct":95,"acres_wfigs":12781.633597236289,"hour":8,"valid_at_utc":"2026-07-30 08:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-112.57528,40.13985],[-112.57528,40.13958],[-112.57598,40.13958],[-112.57598,40.13904],[-112.5781,40.13904],[-112.5781,40.13877],[-112.57563,40.13877],[-112.57563,40.1385],[-112.57528,40.1385],[-112.57528,40.13823],[-112.57493,40.13823],[-112.57493,40.1385],[-112.57387,40.1385],[-112.57387,40.13823],[-112.57316,40.13823],[-112.57316,40.13796],[-112.57352,40.13796],[-112.57352,40.13769],[-112.57387,40.13769],[-112.57387,40.13742],[-112.57457,40.13742],[-112.57457,40.13661],[-112.57352,40.13661],[-112.57352,40.13607],[-112.57281,40.13607],[-112.57281,40.13554],[-112.5721,40.13527],[-112.5721,40.13419],[-112.57281,40.13419],[-112.57281,40.13365],[-112.57316,40.13365],[-112.57316,40.13284],[-112.57175,40.13284],[-112.57175,40.13257],[-112.5714,40.13257],[-112.5714,40.1323],[-112.57069,40.13203],[-112.57069,40.13176],[-112.57105,40.13176],[-112.57105,40.13149],[-112.5721,40.13149],[-112.5721,40.13176],[-112.57246,40.13176],[-112.57246,40.13203],[-112.57387,40.13203],[-112.57387,40.13176],[-112.57422,40.13176],[-112.57422,40.13068],[-112.57387,40.13068],[-112.57387,40.12961],[-112.57316,40.12961],[-112.57316,40.12934],[-112.57069,40.12934],[-112.57069,40.12907],[-112.57034,40.12907],[-112.57034,40.1288],[-112.57069,40.1288],[-112.57069,40.12853],[-112.57105,40.12853],[-112.57105,40.1288],[-112.57281,40.1288],[-112.57281,40.12853],[-112.57352,40.12853],[-112.57352,40.12799],[-112.57246,40.12799],[-112.57246,40.12745],[-112.5714,40.12745],[-112.5714,40.12718],[-112.5724