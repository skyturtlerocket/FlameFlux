ning. The measured t0-window numbers above already reflect that (they are not a surprise), but this is 'best available', not 'production-ready' -- represent it that way. The operating_point (floor=0.0, mult=0.9) is the VAL-selected connected-causal decode point; it did NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-08-13 20:10:26.809854+00:00","valid_from_utc":"2026-08-13 00:00:00","valid_to_utc":"2026-08-14 00:00:00","wfigs_date_current_utc":"2026-08-13 18:03:41+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":5,"degraded_history":false,"containment_pct":3,"acres_wfigs":88421.65124924152}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-120.00069,39.69213],[-119.99999,39.6924],[-119.99999,39.69213],[-119.99929,39.69213],[-119.99929,39.69186],[-120.00069,39.69186],[-120.00069,39.69213]]],[[[-120.00069,39.69213],[-120.00244,39.69213],[-120.00244,39.6924],[-120.00069,39.6924],[-120.00069,39.69213]]],[[[-120.00349,39.69294],[-120.00279,39.69294],[-120.00279,39.69267],[-120.00244,39.69267],[-120.00244,39.6924],[-120.00314,39.6924],[-120.00314,39.69267],[-120.00349,39.69267],[-120.00349,39.69294]]],[[[-120.00419,39.69348],[-120.00384,39.69348],[-120.00384,39.69402],[-120.00349,39.69402],[-120.00349,39.69456],[-120.00314,39.69456],[-120.00314,39.6951],[-120.00279,39.6951],[-120.00279,39.69563],[-120.00244,39.69563],[-120.00244,39.69483],[-120.00279,39.69483],[-120.00279,39.69429],[-120.00314,39.69429],[-120.00314,39.69375],[-120.00349,39.69375],[-120.00349,39.69321],[-120.00419,39.69321],[-120.00419,39.69348]]],[[[-120.00244,39.69914],[-120.00209,39.69914],[-120.00209,39.69698],[-120.00174,39.69698],[-120.00174,39.69671],[-120.00209,39.69671],[-120.00209,39.69563],[-120.00244,39.69563],[-120.00244,39.69914]]],[[[-120.00244,39.69914],[-120.00279,39.69914],[-120.00