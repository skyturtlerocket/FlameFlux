 NOT clear the 0.50 precision floor during selection (feasible=False, val P=0.270/R=0.259) -- it's the best-F1 fallback point, not a precision-guaranteed one.","issued_at_utc":"2026-07-30 18:12:55.648757+00:00","valid_from_utc":"2026-07-30 00:00:00","valid_to_utc":"2026-07-31 00:00:00","wfigs_date_current_utc":"2026-07-30 16:23:23+00:00","pixel_size_m":30,"veg_source":"refreshed_d4","physics_source":"eikonal_fbfm40","history_n_dates":1,"degraded_history":true,"containment_pct":95,"acres_wfigs":12781.633597236289,"hour":18,"valid_at_utc":"2026-07-30 18:00:00"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[-112.55623,40.08757],[-112.55623,40.08783],[-112.55588,40.08783],[-112.55588,40.08757],[-112.55623,40.08757]]],[[[-112.55623,40.10724],[-112.55588,40.10724],[-112.55588,40.10697],[-112.55623,40.10697],[-112.55623,40.10724]]],[[[-112.5647,40.14874],[-112.56435,40.14874],[-112.56435,40.14847],[-112.5647,40.14847],[-112.5647,40.14874]]],[[[-112.56364,40.14847],[-112.56399,40.14847],[-112.56399,40.14874],[-112.56364,40.14874],[-112.56364,40.14847]]],[[[-112.54671,40.21315],[-112.54636,40.21315],[-112.54636,40.21342],[-112.54601,40.21342],[-112.54601,40.21315],[-112.54566,40.21315],[-112.54566,40.21342],[-112.5453,40.21342],[-112.5453,40.21315],[-112.54495,40.21315],[-112.54495,40.21342],[-112.5446,40.21342],[-112.5446,40.21315],[-112.54319,40.21315],[-112.54319,40.21288],[-112.54248,40.21288],[-112.54248,40.21261],[-112.54178,40.21234],[-112.54178,40.2118],[-112.54142,40.2118],[-112.54142,40.21207],[-112.53895,40.21207],[-112.53895,40.2118],[-112.5386,40.2118],[-112.5386,40.21207],[-112.53649,40.21207],[-112.53649,40.2118],[-112.53578,40.2118],[-112.53578,40.21207],[-112.53543,40.21207],[-112.53543,40.21234],[-112.53472,40.21261],[-112.53472,40.21234],[-112.53402,40.21234],[-112.53402,40.21207],[-112.53366,40.21207],[-112.53366,40.21153],[-112.53331,40.21153],[-112.53331,40.21126],[-112.53261,40.21126],[-112.53261,40.21072],[-112.5319,40.21072],